# -------------------------------------------------------
# Boots – local environment template
# Copy this file to .env.local and fill in the values.
#
#   cp .env.local.example .env.local
#
# .env.local is in .gitignore – never commit real secrets.
# -------------------------------------------------------

# ---------------------------
# Supabase (required for auth + cloud progress sync)
# ---------------------------
# Find these in your Supabase project:
#   Settings → API → Project URL / anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------
# Optional – future features
# ---------------------------
# Stripe (pricing / subscriptions)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Anthropic (Boots AI tutor)
# ANTHROPIC_API_KEY=sk-ant-...
