# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). The app runs without these — it falls back to
# local-only game state — but auth and cloud progress require them.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# The app runs without these (checkout returns a friendly "not configured").
# Create two recurring Prices in Stripe and paste their IDs here.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Used to build absolute success/cancel URLs (falls back to request origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI tutor "Ask Boots" (Anthropic) ────────────────────────────────────────
# Server-side only — never exposed to the browser. Without it, /api/tutor
# returns a friendly "not configured" message. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub "coding journey" App ──────────────────────────────────────────────
# Lets learners commit their solutions + a progress README to their own repo as
# they complete lessons (see docs/github-journal.md to register the App).
# The app runs without these — the integration just stays hidden/disabled.
GITHUB_APP_ID=123456
# The App's PEM private key. Paste it on one line with literal \n for newlines,
# e.g. "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
# The App's public slug (from its GitHub URL: github.com/apps/<slug>). Public —
# used to build the "Connect" install link in the browser.
NEXT_PUBLIC_GITHUB_APP_SLUG=your-app-slug

# ── Service role (server-only jobs: cron email/push, league close) ───────────
# Supabase → Project Settings → API → service_role secret. NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ── Lifecycle email (Resend) ─────────────────────────────────────────────────
# Without it, email routes no-op. Get a key at resend.com.
RESEND_API_KEY=
EMAIL_FROM=Cantrip <onboarding@resend.dev>

# ── Web Push (PWA notifications) ─────────────────────────────────────────────
# Generate a VAPID keypair: `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@cantrip.dev

# ── Cron protection ──────────────────────────────────────────────────────────
# Shared secret required (as `Authorization: Bearer <secret>`) by the cron routes
# /api/email/streak-reminder, /api/push/send, /api/leagues/close-season.
CRON_SECRET=
